title(ylab=expression(paste('log[ Streamflow (', ft^3~ s^-1, ') ]', sep='')), line=4, cex.axis=1.5)
lines(sf_obs$date, sf_obs[,(i+6)] + 0.1, typ='l',lty=2, col='red')
