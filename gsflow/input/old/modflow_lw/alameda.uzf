#Alameda Simulation -- GSFLOW
options
SPECIFYTHTI
specifysurfk
SEEPSURFK
end
3  1  1 1 0 0 7 120 1 0.1                     																					# NUZTOP IUZFOPT IRUNFLG IETFLG IUZFCB1 IUZFCB2 NTRAIL NSETS NUZGAGES SURFDEP
OPEN/CLOSE .\input\modflow_lw\uzf_support\iuzfbnd.txt                1 (free)    6      # UZFBND
OPEN/CLOSE .\input\modflow_lw\uzf_support\irunbnd.txt                1 (free)    6      # IRUNBND
OPEN/CLOSE .\input\modflow_lw\uzf_support\vks.txt                 10.0 (free)    0      # VKS         
OPEN/CLOSE .\input\modflow_lw\uzf_support\surfk.txt               10.0 (free)    0      # SURFK       
CONSTANT   4.0                                                                          # BROOKS/COREY EPSILON (EPS)
CONSTANT   0.35                                                                         # SATURATED WATER CONTENT (THTS)
OPEN/CLOSE .\input\modflow_lw\uzf_support\thti.txt                1.002 (free)    0     # INITIAL WATER CONTENT (THTI)
-85                                             																				# IFTUNIT
1                                                                                       # NUZF1
OPEN/CLOSE .\input\modflow_lw\uzf_support\finf.txt                0.75 (free)    0      # INFILTRATION AT TOP OF LAYER 1 (FINF) STRESS PERIOD 1
1                                                                                       # NUZF2
OPEN/CLOSE .\input\modflow_lw\uzf_support\pET.txt                  1.0 (free)    0      # PET FOR STRESS PERIOD 1   # orig is 0.003556020
1                                                                                   		# NUZF3
OPEN/CLOSE .\input\modflow_lw\uzf_support\extdp.txt    							1 (free)    0       # EXTDP FOR STRESS PERIOD 1
1                                                                                       # NUZF4
CONSTANT  0.41406    																																		# EXTWC FOR STRESS PERIOD 1
